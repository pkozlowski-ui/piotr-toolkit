{
  "description": "Uniwersalna egzekucja niezawodności: anty-bloat guard na plikach instrukcji (PreToolUse blokuje wzrost, PostToolUse łapie zapisy przez Bash, których nie da się przewidzieć z tekstu komendy) + re-injection twardych reguł co turę + deterministyczny routing intent→skill (UserPromptSubmit) + blokada zaproszeń do wysyłki (Stop). Deterministyczne guardy zamiast miękkich reguł, które gasną w długiej sesji.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-send-invitation.sh\"",
            "statusMessage": "guard: zaproszenie do wysyłki"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-claudemd-bloat.sh\"",
            "statusMessage": "anty-bloat guard"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/reinject-rules.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/route-skills.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/context-watch.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-claudemd-bloat.sh\"",
            "statusMessage": "anty-bloat guard (post)"
          }
        ]
      }
    ]
  }
}
