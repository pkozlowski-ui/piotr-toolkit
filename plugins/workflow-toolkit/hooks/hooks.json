{
  "description": "Uniwersalna egzekucja niezawodności: anty-bloat guard na plikach instrukcji (PreToolUse blokuje wzrost, PostToolUse łapie zapisy przez Bash, których nie da się przewidzieć z tekstu komendy) + re-injection twardych reguł co turę + deterministyczny routing intent→skill (UserPromptSubmit) + blokada zaproszeń do wysyłki (Stop). Deterministyczne guardy zamiast miękkich reguł, które gasną w długiej sesji + brama na przelaczanie modelu (PreModelSwitch pyta o potwierdzenie przy Fable 5 ponad progiem 50% limitu 7d, PostModelSwitch wstrzykuje wiersz tabeli routingu i realny koszt przebudowy cache) + brama twardego sufitu wydatku (UserPromptSubmit BLOKUJE prompt, gdy sesja przelala sie w platne usage credits ponad zaakceptowany baseline; ostrzega przy 90% limitu planu).",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-send-invitation.sh\"",
            "statusMessage": "guard: zaproszenie do wysyłki"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-claudemd-bloat.sh\"",
            "statusMessage": "anty-bloat guard"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gate-spend-ceiling.sh\"",
            "statusMessage": "brama: twardy sufit wydatku"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/reinject-rules.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/route-skills.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/context-watch.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-claudemd-bloat.sh\"",
            "statusMessage": "anty-bloat guard (post)"
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gate-model-switch.sh\"",
            "statusMessage": "brama: prog Fable 50% 7d"
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gate-model-switch.sh\"",
            "statusMessage": "adnotacja: routing modeli"
          }
        ]
      }
    ]
  }
}
