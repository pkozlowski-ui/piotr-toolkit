{
  "description": "Uniwersalna egzekucja niezawodnosci: anty-bloat guard na plikach instrukcji (PreToolUse blokuje wzrost, PostToolUse lapie zapisy przez Bash, ktorych nie da sie przewidziec z tekstu komendy) + re-injection twardych regul co ture + deterministyczny routing intent->skill (UserPromptSubmit). Deterministyczne guardy zamiast miekkich regul, ktore gasna w dlugiej sesji.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-claudemd-bloat.sh\"",
            "statusMessage": "anty-bloat guard"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/reinject-rules.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/route-skills.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/context-watch.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-claudemd-bloat.sh\"",
            "statusMessage": "anty-bloat guard (post)"
          }
        ]
      }
    ]
  }
}
